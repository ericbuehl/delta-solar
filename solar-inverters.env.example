# serial=MAC pairs, one per inverter. Obtain MAC addresses via bluetoothctl.
# Replace these synthetic identifiers and placeholder MACs with your own values.
INVERTERS=example-a=AA:BB:CC:DD:EE:FF,example-b=00:11:22:33:44:55
INFLUX_URL=http://127.0.0.1:8086
INFLUX_DATABASE=solar
POLL_INTERVAL_SECONDS=60
POLL_TIMEOUT_SECONDS=45
# sequential: one complete Bluetooth attempt at a time; backoff releases the slot
# concurrent: overlapping reads, serialized discovery/connection attempts
POLL_MODE=sequential
# Bluetooth timing (all configurable to tune for your hardware)
# Maximum wait for a fresh target sighting, not a fixed sleep
SCAN_DURATION_SECONDS=5
INTER_COMMAND_SLEEP_MS=100
DISCONNECT_TIMEOUT_SECONDS=5
BLUETOOTH_ADAPTER_INDEX=0
SPOOL_DIR=/var/lib/delta-solar
TZ=America/Los_Angeles
RUST_LOG=delta_solar=info
